        lv2:minimum 0.1 ;
        lv2:maximum 5.0 ;
        units:unit units:hz
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "depth" ;
        lv2:name "Depth" ;
        lv2:default 0.4 ;
        lv2:minimum 0.0 ;
        lv2:maximum 1.0
