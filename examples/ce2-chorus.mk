endef

define CE2_CHORUS_INSTALL_TARGET_CMDS
	mkdir -p $($(PKG)_PKGDIR)/ce2-chorus.lv2
	cp $(@D)/bin/ce2-chorus.lv2/ce2-chorus_dsp.so $($(PKG)_PKGDIR)/ce2-chorus.lv2/
