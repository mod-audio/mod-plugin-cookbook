#
# CE-2 Chorus — a Boss CE-2-inspired chorus effect for the MOD Online Builder.
#
# Mono in / mono out. Two controls: Rate and Depth. The plugin follows the
# original CE-2 topology — a single delayed voice with a sinusoidal LFO
# modulating a short delay line (~7 ms centre, ±3.5 ms swing), mixed 50/50
# with the dry signal. Linear interpolation across the fractional delay
# read position keeps pitch transitions smooth.
#
# This recipe is a cookbook example demonstrating a *time-based* effect:
# circular delay buffer, LFO state, fractional interpolation, activate()
# zeroing the buffer on (re)start. Compare with examples/gain.mk, which is
# a pure callback plugin with no state beyond two floats.
#
# Originally generated by Claude (Anthropic) from a one-line prompt, then
# validated end-to-end on a MOD Dwarf and contributed to the cookbook.

CE2_CHORUS_VERSION = 61d38eb638449647fb8395a35c5b8dab7e981ba7
CE2_CHORUS_SITE = https://github.com/DISTRHO/DPF.git
CE2_CHORUS_SITE_METHOD = git
CE2_CHORUS_BUNDLES = ce2-chorus.lv2

define CE2_CHORUS_PLUGIN_CPP
#include "DistrhoPlugin.hpp"
#include <cmath>
#include <cstring>

START_NAMESPACE_DISTRHO

// Max delay line length: 50 ms at 192 kHz gives plenty of headroom.
static const int kMaxDelaySamples = 9600;

class CE2ChorusPlugin : public Plugin
{
public:
    CE2ChorusPlugin()
        : Plugin(kParameterCount, 0, 0),
          fRate(0.5f),
          fDepth(0.4f),
          fPhase(0.0f),
          fWritePos(0),
          fSampleRate(44100.0f)
    {
        memset(fDelayLine, 0, sizeof(fDelayLine));
    }

protected:
    const char* getLabel()       const override { return "CE2Chorus"; }
    const char* getDescription() const override { return "Boss CE-2 inspired chorus effect."; }
    const char* getMaker()       const override { return "Gianfranco Ceccolini"; }
    const char* getHomePage()    const override { return "https://mod.audio"; }
    const char* getLicense()     const override { return "MIT"; }
    uint32_t    getVersion()     const override { return d_version(1, 0, 0); }
    int64_t     getUniqueId()    const override { return d_cconst('C', 'E', '2', 'c'); }

    void initParameter(uint32_t index, Parameter& parameter) override
    {
        switch (index)
        {
        case kRate:
            parameter.hints      = kParameterIsAutomatable;
            parameter.name       = "Rate";
            parameter.symbol     = "rate";
            parameter.unit       = "Hz";
            parameter.ranges.def = 0.5f;
            parameter.ranges.min = 0.1f;
            parameter.ranges.max = 5.0f;
            break;
        case kDepth:
            parameter.hints      = kParameterIsAutomatable;
            parameter.name       = "Depth";
            parameter.symbol     = "depth";
            parameter.unit       = "";
            parameter.ranges.def = 0.4f;
            parameter.ranges.min = 0.0f;
            parameter.ranges.max = 1.0f;
            break;
        default:
            break;
        }
    }

    float getParameterValue(uint32_t index) const override
    {
        switch (index)
        {
        case kRate:  return fRate;
        case kDepth: return fDepth;
        default:     return 0.0f;
        }
    }

    void setParameterValue(uint32_t index, float value) override
    {
        switch (index)
        {
        case kRate:  fRate  = value; break;
        case kDepth: fDepth = value; break;
        default: break;
        }
    }

    void activate() override
    {
        fSampleRate = (float)getSampleRate();
        fPhase      = 0.0f;
        fWritePos   = 0;
        memset(fDelayLine, 0, sizeof(fDelayLine));
    }

    void run(const float** inputs, float** outputs, uint32_t frames) override
    {
        const float* in  = inputs[0];
        float*       out = outputs[0];

        // CE-2 centre delay: ~7 ms, modulation swing: +-3.5 ms (depth-scaled)
        const float centreMs  = 7.0f;
        const float swingMs   = 3.5f * fDepth;
        const float centreSmp = centreMs  * fSampleRate * 0.001f;
        const float swingSmp  = swingMs   * fSampleRate * 0.001f;
        const float phaseInc  = fRate / fSampleRate;
        const float twoPi     = 6.283185307f;

        for (uint32_t i = 0; i < frames; ++i)
        {
            // Write current sample into delay line
            fDelayLine[fWritePos] = in[i];

            // LFO (sine)
            float lfo = sinf(fPhase * twoPi);
            fPhase += phaseInc;
            if (fPhase >= 1.0f) fPhase -= 1.0f;

            // Delay read position with fractional interpolation
            float delaySmp = centreSmp + lfo * swingSmp;
            if (delaySmp < 1.0f)   delaySmp = 1.0f;
            if (delaySmp > (float)(kMaxDelaySamples - 2))
                delaySmp = (float)(kMaxDelaySamples - 2);

            int   readInt  = fWritePos - (int)delaySmp;
            float frac     = delaySmp - (int)delaySmp;
            if (readInt < 0) readInt += kMaxDelaySamples;

            int readInt2 = readInt - 1;
            if (readInt2 < 0) readInt2 += kMaxDelaySamples;

            float delayed = fDelayLine[readInt] * (1.0f - frac)
                          + fDelayLine[readInt2] * frac;

            // Mix: 50% dry + 50% wet (classic CE-2 blend)
            out[i] = 0.5f * in[i] + 0.5f * delayed;

            fWritePos++;
            if (fWritePos >= kMaxDelaySamples) fWritePos = 0;
        }
    }

private:
    float fRate;
    float fDepth;
    float fPhase;
    float fDelayLine[kMaxDelaySamples];
    int   fWritePos;
    float fSampleRate;

    DISTRHO_DECLARE_NON_COPYABLE_WITH_LEAK_DETECTOR(CE2ChorusPlugin)
};

Plugin* createPlugin() { return new CE2ChorusPlugin(); }

END_NAMESPACE_DISTRHO
endef

